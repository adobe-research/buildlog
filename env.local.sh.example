# Copy to env.local.sh (gitignored), fill in, and `source env.local.sh` before running the tests.
# Unset variables make the dependent tests skip.
# Note: buildlog reads BUILDLOG_<VAR> as an override of a spec variable <VAR> (facts.py), so
# variables for other tools must not use the BUILDLOG_ prefix.

# Patched Soufflé binary (see README.md: build with -DSOUFFLE_DOMAIN_64BIT=ON).
export BUILDLOG_SOUFFLE=/path/to/souffle/build/src/souffle
# Halide install prefix: `cmake --install <build> --prefix DIR` of a build of case-studies/halide/upstream
# (tests/projects/halide/README.md).
export BUILDLOG_HALIDE_PREFIX=/path/to/halide-install
# Halide CMake build tree (cmake-release) from case-studies/halide/baseline/run-cmake.sh;
# default is build/case-halide/cmake-release.
export BUILDLOG_HALIDE_CMAKE_TREE=/path/to/build/case-halide/cmake-release
# SPIRV-Headers install prefixes (cmake --install of SPIRV-Headers 29981f65, and tag vulkan-sdk-1.4.363.0
# for the alternate); case-studies/spirv-tools/README.md. Also run case-studies/spirv-tools/fetch-deps.sh.
export BUILDLOG_SPIRV_HEADERS_PREFIX=/path/to/spirv-headers-prefix
export BUILDLOG_SPIRV_HEADERS_ALT_PREFIX=/path/to/spirv-headers-prefix-alt
# Qt 6 macOS prefix (case-studies/qt-moc/README.md).
export BUILDLOG_QT_PREFIX=/path/to/qt/6.11.3/macos
# Directory holding venv313/ and venv311/ (case-studies/nanobind/README.md); default build/case-nanobind.
export BUILDLOG_NANOBIND_VENVS=/path/to/nanobind-venvs
# Halide cross-compilation apps (case-studies/halide/apps/README.md): emsdk (3.1.73), a binaryen
# newer than emsdk's bundled one (Halide's LLVM emits features it rejects), and an Android NDK.
# These are standard names, not BUILDLOG_*, so they do not override spec variables.
# export EMSDK=/path/to/emsdk
# export EM_BINARYEN_ROOT=/path/to/binaryen
# export ANDROID_NDK_ROOT=/path/to/Android/sdk/ndk/30.0.15729638
