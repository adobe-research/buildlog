// A toy generator: one action per alpha_resource, emitting out:gen/alpha/<name>.cc.
// gen_item is a private helper; its name deliberately collides across packages.
.decl alpha_resource(name:symbol)
.decl gen_item(name:symbol, out:symbol)
gen_item(n, cat("out:gen/alpha/", n, ".cc")) :- alpha_resource(n).
action(o, "ALPHA") :- gen_item(_, o).
action_arg(o, 0, "", "alpha-gen") :- gen_item(_, o).
action_arg(o, 1, "--name=", n) :- gen_item(n, o).
default_output(o) :- gen_item(_, o).
