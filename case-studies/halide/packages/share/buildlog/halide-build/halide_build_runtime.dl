// RUNTIME_HEADER_FILES, with the symbol part CMake derives ('.' -> '_').
halide_build_runtime_header("HalideBuffer.h", "HalideBuffer_h"). halide_build_runtime_header("HalidePyTorchCudaHelpers.h", "HalidePyTorchCudaHelpers_h").
halide_build_runtime_header("HalidePyTorchHelpers.h", "HalidePyTorchHelpers_h"). halide_build_runtime_header("HalideRuntime.h", "HalideRuntime_h").
halide_build_runtime_header("HalideRuntimeCuda.h", "HalideRuntimeCuda_h"). halide_build_runtime_header("HalideRuntimeD3D12Compute.h", "HalideRuntimeD3D12Compute_h").
halide_build_runtime_header("HalideRuntimeHexagonDma.h", "HalideRuntimeHexagonDma_h"). halide_build_runtime_header("HalideRuntimeHexagonHost.h", "HalideRuntimeHexagonHost_h").
halide_build_runtime_header("HalideRuntimeMetal.h", "HalideRuntimeMetal_h"). halide_build_runtime_header("HalideRuntimeOpenCL.h", "HalideRuntimeOpenCL_h").
halide_build_runtime_header("HalideRuntimeQurt.h", "HalideRuntimeQurt_h"). halide_build_runtime_header("HalideRuntimeVulkan.h", "HalideRuntimeVulkan_h").
halide_build_runtime_header("HalideRuntimeWebGPU.h", "HalideRuntimeWebGPU_h").

// ---- data triples, by module name (CMake's MATCHES) ----
.decl halide_build_rt_kind(m:symbol, kind:symbol)
halide_build_rt_kind(m, "win_x86") :- halide_build_runtime_cpp(m), match("windows_.*_x86", m).
halide_build_rt_kind(m, "win_arm") :- halide_build_runtime_cpp(m), match("windows_.*_arm", m).
halide_build_rt_kind(m, "win") :- halide_build_runtime_cpp(m), match("windows_.*", m),
  !match("windows_.*_x86", m), !match("windows_.*_arm", m).
halide_build_rt_kind(m, "webgpu") :- halide_build_runtime_cpp(m), !match("windows_.*", m), match(".*webgpu.*", m).
halide_build_rt_kind(m, "generic") :- halide_build_runtime_cpp(m), !match("windows_.*", m), !match(".*webgpu.*", m).

.decl halide_build_rt_triple(kind:symbol, j:number, triple:symbol)
halide_build_rt_triple("win_x86", 32, "i386-unknown-windows-unknown").
halide_build_rt_triple("win_x86", 64, "x86_64-unknown-windows-unknown").
halide_build_rt_triple("win", 32, "i386-unknown-windows-unknown").
halide_build_rt_triple("win", 64, "x86_64-unknown-windows-unknown").
halide_build_rt_triple("webgpu", 32, "wasm32-unknown-unknown-unknown").
halide_build_rt_triple("webgpu", 64, "wasm64-unknown-unknown-unknown").
halide_build_rt_triple("generic", 32, "i386-unknown-unknown-unknown").
halide_build_rt_triple("generic", 64, "x86_64-unknown-unknown-unknown").
// Windows on ARM only for the backends the build enables (CMake skips the rest).
halide_build_rt_triple("win_arm", 32, "arm-unknown-windows-unknown") :- halide_build_llvm_backend("ARM", _).
halide_build_rt_triple("win_arm", 64, "aarch64-unknown-windows-unknown") :- halide_build_llvm_backend("AArch64", _).

.decl halide_build_rt_suffix(debug:number, suffix:symbol)
halide_build_rt_suffix(0, ""). halide_build_rt_suffix(1, "_debug").

.decl halide_build_rt_dir(lib:symbol, c:Cfg, d:symbol)
halide_build_rt_dir(l, c, cat("out:gen/", n, "/", l, "/runtime")) :-
  halide_build_runtime(l, _, _, _, _, _, _), needed(l, c), cfg_name(c, n).

// ---- C++ modules: clang -> llvm-as -> embed ----
// halide_build_rt_cc(lib, c, ll, m, j, debug, name, triple, dir): one compile
// to dir/initmod.<name>.ll, name = m_j[_debug].
.decl halide_build_rt_cc(lib:symbol, c:Cfg, ll:symbol, m:symbol, j:number, debug:number, name:symbol, triple:symbol, d:symbol)
halide_build_rt_cc(l, c, cat(d, "/initmod.", x, ".ll"), m, j, g, x, t, d) :-
  halide_build_rt_dir(l, c, d), halide_build_runtime_cpp(m), halide_build_rt_kind(m, k),
  halide_build_rt_triple(k, j, t), halide_build_rt_suffix(g, s), x = cat(m, "_", to_string(j), s).
action(o, "RUNTIME_CC"), target_action(l, c, o), action_run(o, 0, "", "Clang::clang", "run") :-
  halide_build_rt_cc(l, c, o, _, _, _, _, _, _).
action_arg(o, 10 + r, "", f) :- halide_build_rt_cc(_, _, o, _, _, _, _, _, _), halide_build_runtime_flag(r, f).
action_arg(o, 60, "", "-isystem"), action_arg(o, 61, "", cat("src:", i)) :-
  halide_build_rt_cc(l, _, o, _, _, _, _, _, _), halide_build_runtime_include(l, i).
action_arg(o, 62, "", "-fpic") :- halide_build_rt_cc(_, _, o, m, _, _, _, _, _), !match("windows_.*", m).
action_arg(o, 63, "", "-fshort-wchar") :- halide_build_rt_cc(_, _, o, m, 64, _, _, _, _), halide_build_rt_kind(m, "win").
action_arg(o, 64, "", "-g"), action_arg(o, 65, "", "-DDEBUG_RUNTIME") :- halide_build_rt_cc(_, _, o, _, _, 1, _, _, _).
action_arg(o, 66, "", "-DCOMPILING_HALIDE_RUNTIME"), action_arg(o, 67, "", cat("-DBITS_", to_string(j))),
action_arg(o, 68, "", cat("-DHALIDE_VERSION=", v)), action_arg(o, 69, "", cat("-DHALIDE_VERSION_MAJOR=", x)),
action_arg(o, 70, "", cat("-DHALIDE_VERSION_MINOR=", y)), action_arg(o, 71, "", cat("-DHALIDE_VERSION_PATCH=", z)),
action_arg(o, 72, "", cat("-m", to_string(j))), action_arg(o, 73, "", "-target"), action_arg(o, 74, "", t),
action_arg(o, 75, "", "-emit-llvm"), action_arg(o, 76, "", "-S"), action_arg(o, 77, "", "-MD"),
action_arg(o, 78, "", "-MF"), action_arg(o, 79, "", f), action_depfile(o, f),
action_arg(o, 80, "", "-o"), action_arg(o, 81, "", o), action_arg(o, 82, "", i), action_in(o, i, "explicit") :-
  halide_build_rt_cc(l, _, o, m, j, _, n, t, d), halide_build_runtime(l, _, s, v, x, y, z),
  f = cat(d, "/initmod.", n, ".d"), i = cat("src:", s, "/", m, ".cpp").

// llvm-as: bitcode from each .ll (compiled or copied).
.decl halide_build_rt_as(lib:symbol, c:Cfg, d:symbol, bc:symbol, ll:symbol)
halide_build_rt_as(l, c, d, cat(d, "/initmod.", n, ".bc"), o) :- halide_build_rt_cc(l, c, o, _, _, _, n, _, d).
action(b, "LLVM_AS"), target_action(l, c, b), action_run(b, 0, "", "LLVM::llvm-as", "run"),
action_arg(b, 1, "", i), action_in(b, i, "explicit"), action_arg(b, 2, "", "-o"), action_arg(b, 3, "", b),
action_cwd(b, d) :- halide_build_rt_as(l, c, d, b, i).

// LLVM modules: a plain copy (CMake's "transformed" .ll), then llvm-as.
.decl halide_build_rt_ll(lib:symbol, c:Cfg, d:symbol, m:symbol, t:symbol)
halide_build_rt_ll(l, c, d, m, cat(d, "/", m, ".ll.transformed.ll")) :-
  halide_build_rt_dir(l, c, d), halide_build_runtime_ll(m).
action(t, "COPY"), target_action(l, c, t), action_builtin(t, "copy"), action_cwd(t, d),
action_arg(t, 1, "", i), action_in(t, i, "explicit"), action_arg(t, 2, "", t) :-
  halide_build_rt_ll(l, c, d, m, t), halide_build_runtime(l, _, s, _, _, _, _), i = cat("src:", s, "/", m, ".ll").
halide_build_rt_as(l, c, d, cat(d, "/initmod.", m, ".bc"), t) :- halide_build_rt_ll(l, c, d, m, t).

// ---- the embeds (halide_build_gen.dl makes the actions) ----
halide_build_embed_file(l, c, d, cat(d, "/_initmod_", n, ".cpp"), g, cat("halide_internal_initmod_", n),
  cat(d, "/initmod.", n, ".bc")) :-
  halide_build_rt_cc(l, c, _, _, _, _, n, _, d), halide_build_runtime(l, g, _, _, _, _, _).
halide_build_embed_file(l, c, d, cat(d, "/_initmod_", m, ".cpp"), g, cat("halide_internal_initmod_", m, "_ll"),
  cat(d, "/initmod.", m, ".bc")) :-
  halide_build_rt_ll(l, c, d, m, _), halide_build_runtime(l, g, _, _, _, _, _).
halide_build_embed_file(l, c, d, cat(d, "/_initmod_ptx_libdevice.cpp"), g, "halide_internal_initmod_ptx_libdevice_ll",
  cat("src:", s, "/nvidia_libdevice_bitcode/libdevice.10.bc")) :-
  halide_build_rt_dir(l, c, d), halide_build_runtime(l, g, s, _, _, _, _).
halide_build_embed_file(l, c, d, cat(d, "/_initmod_inlined_c.cpp"), g, "halide_internal_initmod_inlined_c",
  cat("src:", s, "/halide_buffer_t.cpp")) :-
  halide_build_rt_dir(l, c, d), halide_build_runtime(l, g, s, _, _, _, _).
halide_build_embed_file(l, c, d, cat(d, "/_initmod_", y, ".cpp"), g, cat("halide_internal_runtime_header_", y),
  cat("src:", s, "/", h)) :-
  halide_build_rt_dir(l, c, d), halide_build_runtime(l, g, s, _, _, _, _), halide_build_runtime_header(h, y).

// ---- checks ----
error("Halide runtime stated twice", l) :-
  halide_build_runtime(l, g1, s1, v1, _, _, _), halide_build_runtime(l, g2, s2, v2, _, _, _),
  (g1 < g2 ; s1 < s2 ; v1 < v2).
error("Halide runtime has two include dirs", l) :-
  halide_build_runtime_include(l, x), halide_build_runtime_include(l, y), x < y.
error("Halide runtime include dir without a runtime", l) :-
  halide_build_runtime_include(l, _), !halide_build_has_runtime(l).
.decl halide_build_has_runtime(l:symbol)
halide_build_has_runtime(l) :- halide_build_runtime(l, _, _, _, _, _, _).
