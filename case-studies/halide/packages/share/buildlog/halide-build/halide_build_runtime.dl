// Halide's runtime (M3 phase 3), as src/runtime/CMakeLists.txt builds
// Halide_initmod: each runtime module is compiled to LLVM IR for a data
// triple by the bound Clang, assembled by LLVM's llvm-as, and embedded as a
// C++ byte array by the project's embed tool; the arrays compile into lib.
// The tools are named by target reference (action_run): Clang::clang and
// LLVM::llvm-as are imported executables of the bound LLVM (Clang's package
// requires LLVM's exact version), binary2cpp is built. Core puts each
// in lib's exec configuration: nothing here says where anything runs.
//
// Both tools must come from the package instance of the LLVM that lib links
// (core's import_same_package, checked against the user's package
// selection): the runtime is bitcode for that LLVM. This is what makes the
// runtime's -Werror (CMake's RUNTIME_CXX_FLAGS) integrity, not policy: the
// compiler is fixed by the library, not chosen by the user (buildlog-cpp's
// -Werror check; notes.md, "Include-directory order").
import_same_package("Clang::clang", "LLVM::LLVM").
import_same_package("LLVM::llvm-as", "LLVM::LLVM").
//
// halide_build_runtime(lib, tool, dir, version, major, minor, patch): lib
// embeds the runtime whose sources are under dir (source-relative), with
// tool; the version defines of the runtime compiles.
// halide_build_runtime_include(lib, dir): the system include dir of the
// runtime compiles (the Vulkan headers; at most one).
//
// The modules (CMake's lists RUNTIME_CPP, RUNTIME_LL and
// RUNTIME_HEADER_FILES, and two single files) are explicit facts below, no
// glob (notes.md, "M3 phases 2-3"):
//
// - C++ module m, for bits j in {32, 64}, plain and debug:
//   clang <flags> [-fpic] [-fshort-wchar] [-g -DDEBUG_RUNTIME]
//     -DCOMPILING_HALIDE_RUNTIME -DBITS_j -DHALIDE_VERSION... -mj -target T
//     -emit-llvm -S -MD -MF initmod.m_j.d -o initmod.m_j.ll dir/m.cpp
//   llvm-as initmod.m_j.ll -o initmod.m_j.bc
//   binary2cpp halide_internal_initmod_m_j < initmod.m_j.bc > _initmod_m_j.cpp
//   (_debug appended to the name for debug). T follows the module's name.
// - LLVM module m: copy dir/m.ll to m.ll.transformed.ll, llvm-as it to
//   initmod.m.bc, embed that as _initmod_m.cpp (halide_internal_initmod_m_ll).
// - Header h, halide_buffer_t.cpp and the PTX libdevice bitcode: embedded
//   straight from the source tree.
//
// Everything lands in out:gen/<config>/<lib>/runtime/ (CMake's
// build/src/runtime/), and the commands run there as CMake's do, except the
// clang compile: its depfile names paths relative to its directory, and
// Ninja reads them relative to the build directory (L0 forbids the pair;
// CMake rewrites the depfile with cmake_transform_depfile).

.decl halide_build_runtime(lib:symbol, tool:symbol, dir:symbol, version:symbol, major:symbol, minor:symbol, patch:symbol)
.decl halide_build_runtime_include(lib:symbol, dir:symbol)

.decl halide_build_runtime_cpp(m:symbol)
.decl halide_build_runtime_ll(m:symbol)
.decl halide_build_runtime_header(h:symbol, sym:symbol)
.decl halide_build_runtime_flag(rank:number, flag:symbol)

// RUNTIME_CXX_FLAGS (its -isystem is halide_build_runtime_include).
halide_build_runtime_flag(0, "-O3"). halide_build_runtime_flag(1, "-std=c++17"). halide_build_runtime_flag(2, "-ffreestanding").
halide_build_runtime_flag(3, "-fno-blocks"). halide_build_runtime_flag(4, "-fno-exceptions"). halide_build_runtime_flag(5, "-fno-unwind-tables").
halide_build_runtime_flag(6, "-fno-vectorize"). halide_build_runtime_flag(7, "-fno-threadsafe-statics"). halide_build_runtime_flag(8, "-fno-rtti").
halide_build_runtime_flag(9, "-fno-jump-tables"). halide_build_runtime_flag(10, "-Wall"). halide_build_runtime_flag(11, "-Wc++20-designator").
halide_build_runtime_flag(12, "-Wcast-qual"). halide_build_runtime_flag(13, "-Werror"). halide_build_runtime_flag(14, "-Wignored-qualifiers").
halide_build_runtime_flag(15, "-Wno-comment"). halide_build_runtime_flag(16, "-Wno-psabi"). halide_build_runtime_flag(17, "-Wno-unknown-warning-option").
halide_build_runtime_flag(18, "-Wno-unused-function"). halide_build_runtime_flag(19, "-Wvla"). halide_build_runtime_flag(20, "-Wsign-compare").
halide_build_runtime_flag(21, "-Wimplicit-fallthrough"). halide_build_runtime_flag(22, "-Wno-sync-alignment").

