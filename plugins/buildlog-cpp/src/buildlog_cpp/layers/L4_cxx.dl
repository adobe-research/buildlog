// L4: the C++ language layer. Declares its property keys and lattice, lowers
// sources to native objects, validates against toolchain capabilities.

.decl cxx_source(t:symbol, src:symbol)

set_key("cc.include_dir"). set_key("cc.define"). set_key("cc.generated_header"). set_key("cc.compile_flag").
lattice_rank("cxx.std", "11", 11). lattice_rank("cxx.std", "14", 14). lattice_rank("cxx.std", "17", 17).
lattice_rank("cxx.std", "20", 20). lattice_rank("cxx.std", "23", 23). lattice_rank("cxx.std", "26", 26).

tc_required("cxx", c) :- needed(t, c), cxx_source(t, _).

// Which cxx.std levels a toolchain supports (a probe per toolchain and
// level); a built toolchain's are its author's toolchain_supports facts.
.decl req_cxx_std(id:symbol, tc:symbol, std:symbol)
.decl domain_cxx_std(id:symbol, tc:symbol, std:symbol)
domain_cxx_std(cat("cxx-std:", to_string(strlen(tc)), ":", tc, ":", std), tc, std) :- toolchain(tc, _, _), lattice_rank("cxx.std", std, _),
  !toolchain_built(tc).
req_cxx_std(id, tc, std) :- domain_cxx_std(id, tc, std).
.decl res_cxx_std(req:symbol, tc:symbol, std:symbol, ok:symbol)
toolchain_supports(tc, "cxx.std", std) :- res_cxx_std(req, tc, std, "yes"), req_cxx_std(req, tc, std).

.decl cxx_object(t:symbol, c:Cfg, src:symbol, obj:symbol)
cxx_object(t, c, s, cat("out:obj/", n, "/", t, "/", s, ".o")) :- src_on(t, c, s), cxx_source(t, s), cfg_name(c, n).
native_object(t, c, o) :- cxx_object(t, c, _, o).
target_action(t, c, o) :- cxx_object(t, c, _, o).

action(o, "CXX") :- cxx_object(_, _, _, o).
action_tc_tool(o, tc, "cxx") :- cxx_object(t, c, _, o), tc_of(t, "cxx", c, tc).
action_arg(o, 1, pre, v) :- cxx_object(t, c, _, o), tc_of(t, "cxx", c, tc), config_platform(c, p),
  tc_platform_arg(tc, p, pre, v).
action_arg(o, 5, "", a) :- cxx_object(t, c, _, o), tc_of(t, "cxx", c, tc), tc_setting_arg(tc, c, "compile", a), !config_flag_wiped(t, c, a).
action_arg(o, 15 + r, "", v) :- cxx_object(t, c, _, o), use(t, c, "cc.compile_flag", v, r).
action_arg(o, 10, "-std=c++", v) :- cxx_object(t, c, _, o), use_join(t, c, "cxx.std", v).
action_arg(o, 20 + r, "-D", v) :- cxx_object(t, c, _, o), use(t, c, "cc.define", v, r).
action_arg(o, 40, "-MD -MF ", cat(o, ".d")) :- cxx_object(_, _, _, o), !cxx_scan_deps(o).
action_arg(o, 41, "-c ", p) :- cxx_object_input(o, p).
action_arg(o, 42, "-o ", o) :- cxx_object(_, _, _, o).
// Unordered argv segments (core L0 sorts them lexically): platform and
// setting flags, and, per precedence tier r, flags and defines. Include
// dirs: "include directories" below.
action_arg_set(o, 1), action_arg_set(o, 5) :- cxx_object(_, _, _, o).
action_arg_set(o, 15 + r) :- cxx_object(t, c, _, o), use(t, c, "cc.compile_flag", _, r).
action_arg_set(o, 20 + r) :- cxx_object(t, c, _, o), use(t, c, "cc.define", _, r).
action_depfile(o, cat(o, ".d")) :- cxx_object(_, _, _, o), !cxx_scan_deps(o).
action_in(o, p, "explicit") :- cxx_object_input(o, p).
// Headers generated by upstream actions must exist before we compile.
action_in(o, h, "order_only") :- cxx_object(t, c, _, o), use(t, c, "cc.generated_header", h, _).

error_at("cxx.std not supported by selected toolchain", cat(t, " in ", n, ": c++", v, " with ", tc), t, c) :-
  use_join(t, c, "cxx.std", v), cfg_name(c, n), tc_of(t, "cxx", c, tc), !toolchain_supports(tc, "cxx.std", v).

// ---- system include dirs, PIC ----
// cc.system_include_dir: a dir that is a system dir for its own reasons,
// the last include class ("include directories" below). Include dirs a
// provider reads as system dirs (CMake's INTERFACE_SYSTEM_INCLUDE_DIRECTORIES)
// are, and so, if the user says so per package provider
// (package_system_includes, a user fact), are all include dirs of that
// provider's imports, through core discovery's import_prop_rename. Every
// dependency's include dirs are -isystem anyway, so this only moves a
// package's dirs from the dependency class to the system class: after the
// project's own dependencies' dirs.
set_key("cc.system_include_dir").
.decl package_system_includes(provider:symbol)
import_prop_rename(r, "cc.include_dir", "cc.system_include_dir") :-
  import_req_provider(r, f), package_system_includes(f).
// Objects of shared and module libraries are position-independent.
action_arg(o, 6, "", a) :- cxx_object(t, c, _, o), native_kind_in(t, c, "shared_library"), tc_of(t, "cxx", c, tc),
  toolchain(tc, f, _), family_pic_arg(f, a).
action_arg(o, 6, "", a) :- cxx_object(t, c, _, o), native_kind_in(t, c, "module_library"), tc_of(t, "cxx", c, tc),
  toolchain(tc, f, _), family_pic_arg(f, a).
// C++ ABI settings of the target's own code, when off.
action_arg(o, 7, "", a) :- cxx_object(t, c, _, o), cxx_abi(t, c, k, "off"), tc_of(t, "cxx", c, tc),
  toolchain(tc, f, _), family_cxx_off_arg(f, k, a).
action_arg_set(o, 7) :- cxx_object(_, _, _, o).

// ---- C++ ABI compatibility: RTTI and exceptions ----
// cxx.rtti and cxx.exceptions (on | off) state how a target's C++ code is
// built: a compiled target's own setting (default on, the compiler's), or,
// for an imported library, how it was built (a binding source states it,
// e.g. LLVM's LLVM_ENABLE_RTTI). They are facts about the target, not usage
// requirements: consumers are checked against them, never given them.
// RTTI must agree between a C++ target and every library it uses
// (transitively); exceptions are directional: code built with exceptions
// may use a library built without them, not the reverse. An imported
// library without a stated value is not checked.
set_key("cxx.rtti"). set_key("cxx.exceptions").
.decl cxx_abi_key(k:symbol)
cxx_abi_key("cxx.rtti"). cxx_abi_key("cxx.exceptions").
.decl cxx_abi_stated(t:symbol, c:Cfg, k:symbol, v:symbol)
cxx_abi_stated(t, c, k, v) :- eff_prop(t, c, k, v, _), cxx_abi_key(k).
.decl has_cxx_abi(t:symbol, c:Cfg, k:symbol)
has_cxx_abi(t, c, k) :- cxx_abi_stated(t, c, k, _).
.decl cxx_abi(t:symbol, c:Cfg, k:symbol, v:symbol)
cxx_abi(t, c, k, v) :- cxx_abi_stated(t, c, k, v), 1 = count : { cxx_abi_stated(t, c, k, _) }.
cxx_abi(t, c, k, "on") :- needed(t, c), cxx_source(t, _), cxx_abi_key(k), !has_cxx_abi(t, c, k).
error_at("invalid C++ ABI setting", cat(t, ": ", k, "=", v, " (on or off)"), t, c) :-
  cxx_abi_stated(t, c, k, v), v != "on", v != "off".
error_at("conflicting C++ ABI settings", cat(t, ": ", k, "=", a, " and ", k, "=", b), t, c) :-
  cxx_abi_stated(t, c, k, a), cxx_abi_stated(t, c, k, b), a < b.

.decl cxx_abi_uses(t:symbol, c:Cfg, l:symbol)
cxx_abi_uses(t, c, l) :- cxx_source(t, _), eff_dep(t, c, l, _).
cxx_abi_uses(t, c, l) :- cxx_abi_uses(t, c, m), eff_dep(m, c, l, _).
error_at("C++ RTTI mismatch", cat(t, " is built with cxx.rtti=", a, " but uses ", l, ", built with cxx.rtti=", b), t, c) :-
  cxx_abi_uses(t, c, l), cxx_abi(t, c, "cxx.rtti", a), cxx_abi(l, c, "cxx.rtti", b), a != b.
error_at("C++ exceptions mismatch", cat(t, " is built with cxx.exceptions=off but uses ", l, ", built with cxx.exceptions=on"), t, c) :-
  cxx_abi_uses(t, c, l), cxx_abi(t, c, "cxx.exceptions", "off"), cxx_abi(l, c, "cxx.exceptions", "on").

// ---- generated sources ----
// A layer that generates a C++ source for t in c (an out: path an action
// produces) states cxx_generated_source(t, c, path). It compiles like a
// source file, with t's flags, into out:obj/<config>/<t>/<path below out:>.o.
.decl cxx_generated_source(t:symbol, c:Cfg, path:symbol)   // open
.decl cxx_object_input(o:symbol, path:symbol)
cxx_object_input(o, cat("src:", s)) :- cxx_source(t, s), cxx_object(t, _, s, o).
cxx_object(t, c, s, cat("out:obj/", n, "/", t, "/", s, ".o")) :- cxx_generated_source(t, c, p), needed(t, c),
  substr(p, 0, 4) = "out:", s = substr(p, 4, strlen(p) - 4), cfg_name(c, n).
cxx_object_input(o, p) :- cxx_generated_source(t, c, p), cxx_object(t, c, substr(p, 4, strlen(p) - 4), o).
tc_required("cxx", c) :- cxx_generated_source(t, c, _), needed(t, c).
cxx_abi(t, c, k, "on") :- cxx_generated_source(t, c, _), needed(t, c), cxx_abi_key(k), !has_cxx_abi(t, c, k).
cxx_abi_uses(t, c, l) :- cxx_generated_source(t, c, _), eff_dep(t, c, l, _).
error_at("generated C++ source outside the build tree", cat(t, ": ", p), t, c) :-
  cxx_generated_source(t, c, p), substr(p, 0, 4) != "out:".

// ---- C++-only flags, position-independent code ----
// cxx.compile_flag: a flag for t's C++ compiles only (CMake's
// $<$<COMPILE_LANGUAGE:CXX>:...>); cc.compile_flag reaches every C-family
// compile. cc.pic=on: t's objects are position-independent whatever its
// kind (CMake's POSITION_INDEPENDENT_CODE).
set_key("cxx.compile_flag"). set_key("cc.pic").
action_arg(o, 15 + r, "", v) :- cxx_object(t, c, _, o), use(t, c, "cxx.compile_flag", v, r).
action_arg_set(o, 15 + r) :- cxx_object(t, c, _, o), use(t, c, "cxx.compile_flag", _, r).
action_arg(o, 6, "", a) :- cxx_object(t, c, _, o), use(t, c, "cc.pic", "on", _), tc_of(t, "cxx", c, tc),
  toolchain(tc, f, _), family_pic_arg(f, a).
error_at("invalid cc.pic value", cat(t, ": ", v, " (on)"), t, c) :- use(t, c, "cc.pic", v, _), v != "on".
// The user's position-independent code, above the kind's default (Meson's
// b_staticpic, CMake's CMAKE_POSITION_INDEPENDENT_CODE): cc_pic(target), a
// target id or "*". A static library's objects are otherwise not PIC.
.decl cc_pic(target:symbol)
.decl cc_pic_in(t:symbol, c:Cfg)
cc_pic_in(t, c) :- cc_pic(x), needed(t, c), (x = "*" ; x = t).
error("unknown target", cat(x, " (cc_pic)")) :- cc_pic(x), x != "*", !target_id(x).
action_arg(o, 6, "", a) :- cxx_object(t, c, _, o), cc_pic_in(t, c), tc_of(t, "cxx", c, tc),
  toolchain(tc, f, _), family_pic_arg(f, a).

// ---- C sources ----
// c_source(t, src): a C source of t, compiled by the toolchain's C compiler
// (its "cc" tool, for role "c") with t's C-family usage requirements (cc.*),
// not the C++ ones (cxx.std, cxx.compile_flag), into
// out:obj/<config>/<t>/<src>.o, like a C++ source.
.decl c_source(t:symbol, src:symbol)
.decl c_object(t:symbol, c:Cfg, src:symbol, obj:symbol)
// A template's instances (core's target_template) compile its sources,
// placeholders expanded.
tmpl_want(b, s) :- target_template(b), c_source(b, s).
tmpl_want(b, s) :- target_template(b), cxx_source(b, s).
c_source(t, x) :- instance_of(t, b), c_source(b, s), tmpl_value(t, b, s, x).
cxx_source(t, x) :- instance_of(t, b), cxx_source(b, s), tmpl_value(t, b, s, x).
tc_required("c", c) :- needed(t, c), c_source(t, _).
c_object(t, c, s, cat("out:obj/", n, "/", t, "/", s, ".o")) :- src_on(t, c, s), c_source(t, s), cfg_name(c, n).
native_object(t, c, o), target_action(t, c, o), action(o, "CC"), action_depfile(o, cat(o, ".d")),
action_in(o, cat("src:", s), "explicit"), action_arg(o, 40, "-MD -MF ", cat(o, ".d")),
action_arg(o, 41, "-c ", cat("src:", s)), action_arg(o, 42, "-o ", o),
action_arg_set(o, 1), action_arg_set(o, 5), action_arg_set(o, 6) :- c_object(t, c, s, o).
action_tc_tool(o, tc, "cc") :- c_object(t, c, _, o), tc_of(t, "c", c, tc).
action_arg(o, 1, pre, v) :- c_object(t, c, _, o), tc_of(t, "c", c, tc), config_platform(c, p),
  tc_platform_arg(tc, p, pre, v).
action_arg(o, 5, "", a) :- c_object(t, c, _, o), tc_of(t, "c", c, tc), tc_setting_arg(tc, c, "compile", a), !config_flag_wiped(t, c, a).
action_arg(o, 6, "", a) :- c_object(t, c, _, o), use(t, c, "cc.pic", "on", _), tc_of(t, "c", c, tc),
  toolchain(tc, f, _), family_pic_arg(f, a).
action_arg(o, 6, "", a) :- c_object(t, c, _, o), native_kind_in(t, c, k), (k = "shared_library" ; k = "module_library"),
  tc_of(t, "c", c, tc), toolchain(tc, f, _), family_pic_arg(f, a).
action_arg(o, 6, "", a) :- c_object(t, c, _, o), cc_pic_in(t, c), tc_of(t, "c", c, tc), toolchain(tc, f, _),
  family_pic_arg(f, a).
action_arg(o, 15 + r, "", v) :- c_object(t, c, _, o), use(t, c, "cc.compile_flag", v, r).
action_arg(o, 20 + r, "-D", v) :- c_object(t, c, _, o), use(t, c, "cc.define", v, r).
action_arg_set(o, 15 + r) :- c_object(t, c, _, o), use(t, c, "cc.compile_flag", _, r).
action_arg_set(o, 20 + r) :- c_object(t, c, _, o), use(t, c, "cc.define", _, r).
action_in(o, h, "order_only") :- c_object(t, c, _, o), use(t, c, "cc.generated_header", h, _).

// ---- source groups ----
// source_group(t, g): a named set of t's sources, for per-source conditions
// and properties (CMake's if()-appended sources and
// set_source_files_properties). group_source(t, g, src) puts one of t's
// sources (a c_source or cxx_source, stated as usual) in g.
// group_when(t, g, cond): g's sources compile only in the configurations
// where the condition holds (none: wherever t is needed). Groups are sets
// and may overlap: a source compiles where any of its groups applies, with
// the properties of each that does (zlib-ng's generic fallbacks are in the
// x86 set and in the all-fallbacks set, whose conditions are disjoint). group_prop(t, g, key, value) and group_prop_when(…, cond): a
// compile property of g's objects only, spelled after t's own: cc.define,
// cc.compile_flag and cxx.compile_flag (C++ objects only). The objects stay
// t's (out:obj/<config>/<t>/<src>.o) and compile with t's properties, so a
// group copies nothing; `why src_on(t, c, src)` names the group and its
// condition. A group of one source is a per-source property.
.decl source_group(t:symbol, g:symbol)
.decl group_source(t:symbol, g:symbol, src:symbol)
.decl group_when(t:symbol, g:symbol, cond:symbol)
.decl group_prop(t:symbol, g:symbol, key:symbol, value:symbol)
.decl group_prop_when(t:symbol, g:symbol, key:symbol, value:symbol, cond:symbol)
.decl group_conditional(t:symbol, g:symbol)
group_conditional(t, g) :- group_when(t, g, _).
.decl group_on(t:symbol, c:Cfg, g:symbol)
group_on(t, c, g) :- source_group(t, g), needed(t, c), !group_conditional(t, g).
group_on(t, c, g) :- source_group(t, g), needed(t, c), group_when(t, g, k), cond_holds(c, k).
.decl src_grouped(t:symbol, src:symbol)
src_grouped(t, s) :- group_source(t, _, s).
.decl src_on(t:symbol, c:Cfg, src:symbol)
src_on(t, c, s) :- needed(t, c), c_source(t, s), !src_grouped(t, s).
src_on(t, c, s) :- needed(t, c), cxx_source(t, s), !src_grouped(t, s).
src_on(t, c, s) :- group_source(t, g, s), group_on(t, c, g).
.decl group_use(t:symbol, c:Cfg, g:symbol, key:symbol, value:symbol)
group_use(t, c, g, k, v) :- group_on(t, c, g), group_prop(t, g, k, v).
group_use(t, c, g, k, v) :- group_on(t, c, g), group_prop_when(t, g, k, v, n), cond_holds(c, n).
.decl group_obj(o:symbol, t:symbol, c:Cfg, g:symbol)
group_obj(o, t, c, g) :- c_object(t, c, s, o), group_source(t, g, s).
group_obj(o, t, c, g) :- cxx_object(t, c, s, o), group_source(t, g, s).
action_arg(o, 17, "", v), action_arg_set(o, 17) :- group_obj(o, t, c, g), group_use(t, c, g, "cc.compile_flag", v).
action_arg(o, 17, "", v), action_arg_set(o, 17) :- cxx_object(t, c, s, o), group_source(t, g, s),
  group_use(t, c, g, "cxx.compile_flag", v).
action_arg(o, 22, "-D", v), action_arg_set(o, 22) :- group_obj(o, t, c, g), group_use(t, c, g, "cc.define", v).

// generated_source_prop(t, file, key, value): a compile property (cc.define,
// cc.compile_flag, cxx.compile_flag) of the objects of t's generated sources
// named file (the last path component; the path itself names the
// configuration), spelled after t's own like a group's.
.decl generated_source_prop(t:symbol, file:symbol, key:symbol, value:symbol)
.decl generated_source_obj(o:symbol, t:symbol, c:Cfg, file:symbol)
generated_source_obj(o, t, c, f) :- cxx_generated_source(t, c, p), cxx_object(t, c, substr(p, 4, strlen(p) - 4), o),
  generated_source_prop(t, f, _, _), strlen(f) < strlen(p), substr(p, strlen(p) - strlen(f), strlen(f)) = f,
  substr(p, strlen(p) - strlen(f) - 1, 1) = "/".
action_arg(o, 17, "", v), action_arg_set(o, 17) :- generated_source_obj(o, t, _, f),
  generated_source_prop(t, f, "cc.compile_flag", v).
action_arg(o, 17, "", v), action_arg_set(o, 17) :- generated_source_obj(o, t, _, f),
  generated_source_prop(t, f, "cxx.compile_flag", v).
action_arg(o, 22, "-D", v), action_arg_set(o, 22) :- generated_source_obj(o, t, _, f),
  generated_source_prop(t, f, "cc.define", v).
error("generated source property key is not a per-object compile key (cc.define, cc.compile_flag, cxx.compile_flag)",
  cat(t, ": ", f, ": ", k)) :- generated_source_prop(t, f, k, _), !group_prop_key(k).

.decl group_prop_key(k:symbol)
group_prop_key("cc.define"). group_prop_key("cc.compile_flag"). group_prop_key("cxx.compile_flag").
.decl group_declared(t:symbol, g:symbol)
group_declared(t, g) :- source_group(t, g).
.decl src_stated(t:symbol, src:symbol)
src_stated(t, s) :- c_source(t, s).
src_stated(t, s) :- cxx_source(t, s).
error("source group of an unknown target", cat(t, ": ", g)) :- source_group(t, g), !target(t).
error("group setting for an undeclared source group", cat(t, ": ", g)) :- group_source(t, g, _), !group_declared(t, g).
error("group setting for an undeclared source group", cat(t, ": ", g)) :- group_when(t, g, _), !group_declared(t, g).
error("group setting for an undeclared source group", cat(t, ": ", g)) :- group_prop(t, g, _, _), !group_declared(t, g).
error("group setting for an undeclared source group", cat(t, ": ", g)) :-
  group_prop_when(t, g, _, _, _), !group_declared(t, g).
error("group source is not a C or C++ source of its target (add it to c_source or cxx_source)",
  cat(t, ": ", g, ": ", s)) :- group_source(t, g, s), !src_stated(t, s).
error("source group has two conditions", cat(t, ": ", g, ": ", a, ", ", b)) :- group_when(t, g, a), group_when(t, g, b), a < b.
error("group property key is not a per-object compile key (cc.define, cc.compile_flag, cxx.compile_flag)",
  cat(t, ": ", g, ": ", k)) :- group_prop(t, g, k, _), !group_prop_key(k).
error("group property key is not a per-object compile key (cc.define, cc.compile_flag, cxx.compile_flag)",
  cat(t, ": ", g, ": ", k)) :- group_prop_when(t, g, k, _, _), !group_prop_key(k).

// ---- ISA scopes ----
// What an architecture has is L2's platform knowledge (isa_ext,
// isa_baseline); how a family spells an extension is its F layer's
// (family_isa_*). A project names ISA sets (scopes): the extensions a set
// of TUs needs.
//   isa_requires(s, e)          every TU of s needs e
//   isa_requires_when(s, e, n)  e's flag only where condition n holds (a
//                               feature the code probes for)
//   isa_excludes(s, e)          s compiles with e off (AArch64 +no<sfx>)
//   isa_group(t, g, s)          source group g of t compiles with s's flags
//   isa_target(t, s)            every TU of t does
// The flags are per configuration, by its C toolchain's family, after t's
// own. Derived: isa_compatible(s, cpu), cpu has every extension s names;
// the flags; and the errors. Which sets need what, and where a set is built
// (its gate, reading isa_compatible), stay the project's.
.decl isa_requires(set:symbol, ext:symbol)
.decl isa_requires_when(set:symbol, ext:symbol, cond:symbol)
.decl isa_excludes(set:symbol, ext:symbol)
.decl isa_group(t:symbol, g:symbol, set:symbol)
.decl isa_target(t:symbol, set:symbol)

.decl isa_scope(set:symbol)
isa_scope(s) :- isa_requires(s, _).
.decl isa_uses(set:symbol, ext:symbol)
isa_uses(s, e) :- isa_requires(s, e).
isa_uses(s, e) :- isa_requires_when(s, e, _).
isa_uses(s, e) :- isa_excludes(s, e).
.decl isa_cpu(cpu:symbol)
isa_cpu(cpu) :- isa_ext(cpu, _).
.decl isa_known_ext(ext:symbol)
isa_known_ext(e) :- isa_ext(_, e).
.decl isa_nonbaseline(ext:symbol)
isa_nonbaseline(e) :- isa_ext(cpu, e), !isa_baseline(cpu, e).
// Two extensions can be named in one TU when some architecture has both.
.decl isa_coexist(a:symbol, b:symbol)
isa_coexist(a, b) :- isa_ext(cpu, a), isa_ext(cpu, b).
.decl isa_compatible(set:symbol, cpu:symbol)
isa_compatible(s, cpu) :- isa_scope(s), isa_cpu(cpu), n = count : { isa_uses(s, _) },
  n = count : { isa_uses(s, e), isa_ext(cpu, e) }.

error("unknown ISA extension", cat(s, ": ", e)) :- isa_uses(s, e), !isa_known_ext(e).
error("ISA extensions cannot coexist in one TU (no architecture has both)",
  cat(s, ": ", a, " and ", b)) :- isa_uses(s, a), isa_uses(s, b), a < b, isa_known_ext(a), isa_known_ext(b),
  !isa_coexist(a, b).
error("ISA set both requires and excludes an extension", cat(s, ": ", e)) :- isa_requires(s, e), isa_excludes(s, e).
error("ISA set that requires nothing", s) :- isa_uses(s, _), !isa_scope(s).
error("ISA group of a set that requires nothing", cat(t, ": ", g, ": ", s)) :- isa_group(t, g, s), !isa_scope(s).
error("ISA target of a set that requires nothing", cat(t, ": ", s)) :- isa_target(t, s), !isa_scope(s).
error("ISA group of an undeclared source group", cat(t, ": ", g)) :- isa_group(t, g, _), !group_declared(t, g).
error("ISA target of an unknown target", cat(t, ": ", s)) :- isa_target(t, s), !target(t).

// A set's flags per family: one per additive extension that is not
// baseline, and one -march=<base>+<sfx>+... joining the non-additive ones
// (and the excluded ones' +no<sfx>) in rank order.
.decl isa_scope_flag(set:symbol, fam:symbol, flag:symbol)
.decl isa_scope_flag_when(set:symbol, fam:symbol, flag:symbol, cond:symbol)
isa_scope_flag(s, f, x) :- isa_requires(s, e), isa_nonbaseline(e), family_isa_flag(f, e, x).
isa_scope_flag_when(s, f, x, n) :- isa_requires_when(s, e, n), isa_nonbaseline(e), family_isa_flag(f, e, x).
.decl isa_march_part(set:symbol, fam:symbol, cpu:symbol, rank:number, sfx:symbol)
isa_march_part(s, f, cpu, r, x) :- isa_requires(s, e), isa_nonbaseline(e), family_isa_march_ext(f, e, x, r),
  isa_ext(cpu, e).
isa_march_part(s, f, cpu, r, x) :- isa_excludes(s, e), family_isa_march_off(f, e, x, r), isa_ext(cpu, e).
join_part(cat("isa.march:", f, ":", s), r, x), join_sep(cat("isa.march:", f, ":", s), "+") :-
  isa_march_part(s, f, _, r, x).
.decl isa_march_version(set:symbol, fam:symbol, cpu:symbol, rank:number)
isa_march_version(s, f, cpu, 0) :- isa_march_part(s, f, cpu, _, _).
isa_march_version(s, f, cpu, r) :- isa_requires(s, e), isa_nonbaseline(e), family_isa_march_ext(f, e, _, _),
  isa_ext(cpu, e), family_isa_ext_version(f, e, v), family_isa_march_version(f, cpu, v, r).
.decl isa_scope_march(set:symbol, fam:symbol, base:symbol)
isa_scope_march(s, f, b) :- isa_march_version(s, f, cpu, _), r = max rr : { isa_march_version(s, f, cpu, rr) },
  family_isa_march_version(f, cpu, b, r).
isa_scope_flag(s, f, cat("-march=", b, "+", x)) :- isa_scope_march(s, f, b), joined(cat("isa.march:", f, ":", s), x).

.decl isa_family(fam:symbol)
isa_family(f) :- family_isa_flag(f, _, _).
isa_family(f) :- family_isa_march_ext(f, _, _, _).
.decl isa_spelled(fam:symbol, ext:symbol)
isa_spelled(f, e) :- family_isa_flag(f, e, _).
isa_spelled(f, e) :- family_isa_march_ext(f, e, _, _), isa_ext(cpu, e), family_isa_march_version(f, cpu, _, 0).
// Checked where a set is compiled, with that configuration's family (a
// family may lack an extension another has: GCC 13 has no +sme, so a GCC
// build fails only where a TU needs SME, not wherever a set names it).
.decl isa_scope_used(set:symbol, fam:symbol)
isa_scope_used(s, f) :- isa_target(t, s), needed(t, c), isa_family_of(c, f), isa_family(f).
isa_scope_used(s, f) :- isa_group(t, g, s), group_on(t, c, g), isa_family_of(c, f), isa_family(f).
error("ISA extension has no flag in a family that spells ISA flags", cat(f, ": ", e, " (", s, ")")) :-
  isa_requires(s, e), isa_nonbaseline(e), isa_scope_used(s, f), !isa_spelled(f, e).
error("conditional ISA extension needs an additive flag", cat(s, ": ", e)) :- isa_requires_when(s, e, _),
  isa_nonbaseline(e), isa_scope_used(s, f), !family_isa_flag(f, e, _).
.decl isa_off_spelled(fam:symbol, ext:symbol)
isa_off_spelled(f, e) :- family_isa_march_off(f, e, _, _).
error("excluded ISA extension has no spelling in a family that spells ISA flags", cat(f, ": ", e, " (", s, ")")) :-
  isa_excludes(s, e), isa_scope_used(s, f), !isa_off_spelled(f, e).

.decl isa_family_of(c:Cfg, fam:symbol)
isa_family_of(c, f) :- tc_for("c", c, tc), toolchain(tc, f, _).
group_use(t, c, g, "cc.compile_flag", x) :- isa_group(t, g, s), group_on(t, c, g), isa_family_of(c, f),
  isa_scope_flag(s, f, x).
group_use(t, c, g, "cc.compile_flag", x) :- isa_group(t, g, s), group_on(t, c, g), isa_family_of(c, f),
  isa_scope_flag_when(s, f, x, n), cond_holds(c, n).
prop_in(t, c, "cc.compile_flag", x, "private") :- isa_target(t, s), needed(t, c), isa_family_of(c, f),
  isa_scope_flag(s, f, x).
prop_in(t, c, "cc.compile_flag", x, "private") :- isa_target(t, s), needed(t, c), isa_family_of(c, f),
  isa_scope_flag_when(s, f, x, n), cond_holds(c, n).

// The rejection: a set's TU compiled where the configuration's cpu lacks
// its extensions. For a group, by any target (the project's gate keeps the
// group off there; this catches a target that compiles the file outside
// the group); for a target, wherever it is needed.
.decl isa_source(src:symbol, set:symbol)
isa_source(src, s) :- isa_group(t, g, s), group_source(t, g, src).
error_at("ISA scope incompatible with the configuration's cpu",
  cat(t, ": ", src, " (", s, ") needs ", e, ", which ", cpu, " (", n, ") does not have"), t, c) :-
  isa_source(src, s), src_on(t, c, src), config_attr(c, "platform.cpu", cpu),
  !isa_compatible(s, cpu), isa_uses(s, e), !isa_ext(cpu, e), cfg_name(c, n).
error_at("ISA scope incompatible with the configuration's cpu",
  cat(t, " (", s, ") needs ", e, ", which ", cpu, " (", n, ") does not have"), t, c) :-
  isa_target(t, s), needed(t, c), config_attr(c, "platform.cpu", cpu),
  !isa_compatible(s, cpu), isa_uses(s, e), !isa_ext(cpu, e), cfg_name(c, n).
.decl group_cond_known(n:symbol)
group_cond_known(n) :- condition(n, _).
error("unknown condition", n) :- group_when(_, _, n), !group_cond_known(n).
error("unknown condition", n) :- group_prop_when(_, _, _, _, n), !group_cond_known(n).

// ---- the link driver of C-only links (zlib case study) ----
// clang's "link" tool is the C++ driver (F_clang), which links the C++
// runtime. A linked target whose objects, and every object of everything in
// its link closure, are C objects built here, with nothing imported in the
// closure, links with the C driver instead ("cc"): CMake's linker language
// for C-only targets. Anything else (a C++ or generated object, an object
// another layer adds, an imported library) keeps the C++ driver. An
// object library's objects are its own c_objects, folded into the target
// that owns them (zlib-ng case study), so an object is C wherever it was
// compiled.
.decl link_not_c(t:symbol, c:Cfg)
link_not_c(t, c) :- needed(t, c), native_object(t, c, o), !c_object(_, c, _, o).
link_not_c(t, c) :- link_closure(t, c, l), native_object(l, c, o), !c_object(_, c, _, o).
link_not_c(t, c) :- link_closure(t, c, l), imported(l).
link_role(t, c, "cc") :- c_object(t, c, _, _), native_kind_in(t, c, k),
  (k = "executable" ; k = "shared_library" ; k = "module_library"), !link_not_c(t, c).

// ---- configured headers (zlib case study) ----
// cc_configured_header(g, file): owner g's configured file (core's
// configure_file) is a header. Its directory and the file are an own,
// public property of every target of g (core's configure_member: g itself
// if a target, and owner_member's): cc.include_dir and cc.generated_header,
// so the members' own compiles see the dir as -I and wait for the file,
// and every compile that uses a member gets them through its interface
// (CMake: configure_file into the binary dir, plus
// target_include_directories(... PUBLIC ${PROJECT_BINARY_DIR}) on each
// target). A library's variants share one file per configuration.
.decl cc_configured_header(t:symbol, file:symbol)
// cc_configured_header_dir(g, c, dir) names that dir (for priority facts,
// cc_include_before).
.decl cc_configured_header_dir(t:symbol, c:Cfg, dir:symbol)
cc_configured_header_dir(g, c, substr(p, 0, strlen(p) - strlen(f) - 1)) :-
  cc_configured_header(g, f), configured_file(g, c, f, p).
prop_in(t, c, "cc.include_dir", d, "public") :- cc_configured_header_dir(g, c, d), configure_member(g, t).
prop_in(t, c, "cc.generated_header", p, "public") :- cc_configured_header(g, f), configured_file(g, c, f, p),
  configure_member(g, t).
error("configured header is not a configured file", cat(t, ": ", f)) :- cc_configured_header(t, f),
  !configure_file(t, f).

// ---- include directories ----
// Every C-family compile searches three classes of include dirs, in order:
//   0  the target's own (cc.include_dir at rank 0): -I;
//   1  its dependencies', direct and transitive, in-project and imported
//      alike (cc.include_dir at rank 1): -isystem. A dependency's warnings
//      fire where it compiles its own sources, not again in every consumer;
//   2  dirs that are system dirs for another reason (cc.system_include_dir,
//      own or inherited): -isystem.
// A dir in two classes (through two keys: use() already keeps one rank per
// key) is emitted once, in the earlier class. The compiler would otherwise
// decide: GCC ignores a -I dir that is also a system dir, silently moving
// it to the later class.
// Within a class the dirs are a set, emitted in lexical order (L0's ordered
// segment with its lexical tie-break), except where priority facts order
// two of them (cc_include_before below).
.decl cc_compile(t:symbol, c:Cfg, o:symbol, lang:symbol)
cc_compile(t, c, o, "cxx") :- cxx_object(t, c, _, o).
cc_compile(t, c, o, "c") :- c_object(t, c, _, o).
.decl cc_include_class(cls:number, rank:number, spelling:symbol)
cc_include_class(0, 30, "-I"). cc_include_class(1, 31, "-isystem "). cc_include_class(2, 35, "-isystem ").
.decl cc_include_cand(t:symbol, c:Cfg, dir:symbol, cls:number)
cc_include_cand(t, c, v, r) :- use(t, c, "cc.include_dir", v, r).
cc_include_cand(t, c, v, 2) :- use(t, c, "cc.system_include_dir", v, _).
// A dir the compiler searches by itself (its implicit include dirs, a
// probe per toolchain and language) is not named again: as -isystem it
// would move ahead of the compiler's own order and break #include_next
// (GCC's <cstdlib> finding no <stdlib.h> once /usr/include is named).
.decl req_cc_implicit_include(id:symbol, tc:symbol, lang:symbol)
.decl domain_cc_implicit_include(id:symbol, tc:symbol, lang:symbol)
domain_cc_implicit_include(cat("cc-implicit-include:", to_string(strlen(tc)), ":", tc, ":", l), tc, l) :-
  tc_for(l, _, tc), (l = "c" ; l = "cxx").
.decl cc_implicit_include_for(tc:symbol, lang:symbol)
domain_cc_implicit_include(cat("cc-implicit-include:", to_string(strlen(tc)), ":", tc, ":", l), tc, l) :-
  cc_implicit_include_for(tc, l).
req_cc_implicit_include(id, tc, l) :- domain_cc_implicit_include(id, tc, l).
.decl res_cc_implicit_include(req:symbol, tc:symbol, lang:symbol, dir:symbol)
.decl cc_implicit_include(tc:symbol, lang:symbol, dir:symbol)
cc_implicit_include(tc, l, d) :- res_cc_implicit_include(req, tc, l, d), req_cc_implicit_include(req, tc, l).
// A clang that targets Linux through a sysroot (L2_cross.dl) is not probed for
// that pair; the sysroot's /usr/include (and its multiarch directory) are the
// ones it searches by itself.
cc_implicit_include(tc, l, d) :- cross_sysroot(tc, p, root), linux_cpu_triple(p, _, tr), (l = "c" ; l = "cxx"),
  (d = cat(root, "/usr/include") ; d = cat(root, "/usr/include/", tr)).
.decl cc_include_implicit(o:symbol, dir:symbol)
cc_include_implicit(o, v) :- cc_include_cand(t, c, v, _), cc_compile(t, c, o, l), tc_of(t, l, c, tc),
  cc_implicit_include(tc, l, v).
.decl cc_include(t:symbol, c:Cfg, dir:symbol, cls:number)
cc_include(t, c, v, k) :- cc_include_cand(t, c, v, _), k = min kk : { cc_include_cand(t, c, v, kk) }.
action_seq(o, r, v), action_seq_spelled(o, r, v, s, v) :-
  cc_compile(t, c, o, _), cc_include(t, c, v, k), cc_include_class(k, r, s), !cc_include_implicit(o, v).

// Priority facts. cc_include_before(x, y): wherever dirs x and y are in the
// same class of one compile, x comes first; the other dirs of the class
// stay lexical. It settles a known header collision (or a wrapper header's
// #include_next) between two directories, so it is stated about the
// directories, not about a target: whoever compiles against both gets the
// same order. The order is the transitive closure, so it holds even when a
// dir between the two is absent; a cycle (two contradicting facts, or
// longer) is an error. Priority never moves a dir across classes: -I dirs
// are searched before -isystem ones whatever the argv says.
.decl cc_include_before(x:symbol, y:symbol)
.decl cc_include_precedes(x:symbol, y:symbol)
cc_include_precedes(x, y) :- cc_include_before(x, y).
cc_include_precedes(x, z) :- cc_include_precedes(x, y), cc_include_before(y, z).
error("include-dir priority cycle", cat(x, " is ordered before itself (cc_include_before)")) :-
  cc_include_precedes(x, x).
action_seq_before(o, r, x, y) :- cc_include_precedes(x, y), x != y, cc_include(t, c, x, k), cc_include(t, c, y, k),
  cc_compile(t, c, o, _), cc_include_class(k, r, _), !cc_include_implicit(o, x), !cc_include_implicit(o, y).

// ---- default warnings ----
// Warnings every C-family compile gets where its toolchain supports them,
// as warnings only: the companion -Wno-error= keeps them off the critical
// path whatever else turns warnings into errors. Support is a probe per
// (toolchain, language, flag): Apple clang 21 and GCC 16 reject
// -Wshadow-header, upstream clang 22 has it. -Wshadow-header reports a
// header found in several include dirs (the one chosen and the ones
// ignored). Clang considers only non-system dirs, so under the classes
// above it sees collisions among a target's own -I dirs, not among its
// dependencies'.
.decl cc_default_warning(flag:symbol, no_error:symbol)
cc_default_warning("-Wshadow-header", "-Wno-error=shadow-header").
.decl req_cc_warning(id:symbol, tc:symbol, lang:symbol, flag:symbol)
.decl domain_cc_warning(id:symbol, tc:symbol, lang:symbol, flag:symbol)
domain_cc_warning(cat("cc-warning:", to_string(strlen(tc)), ":", tc, ":", to_string(strlen(l)), ":", l, ":", f), tc, l, f) :-
  tc_for(l, _, tc), (l = "c" ; l = "cxx"), cc_default_warning(f, _).
req_cc_warning(id, tc, l, f) :- domain_cc_warning(id, tc, l, f).
.decl res_cc_warning(req:symbol, tc:symbol, lang:symbol, flag:symbol, ok:symbol)
.decl cc_warning_supported(tc:symbol, lang:symbol, flag:symbol)
cc_warning_supported(tc, l, f) :- res_cc_warning(req, tc, l, f, "yes"), req_cc_warning(req, tc, l, f).
action_arg(o, 8, "", f), action_arg(o, 8, "", n), action_arg_set(o, 8) :-
  cc_compile(t, c, o, l), tc_of(t, l, c, tc), cc_warning_supported(tc, l, f), cc_default_warning(f, n).

// ---- warnings as errors: a user decision ----
// Whether warnings fail the build is the user's call where the user picks
// the compiler: which code warns changes with the compiler and its version
// (e.g. -Wmaybe-uninitialized), so an author's -Werror breaks downstream
// builds on toolchains the author never tried. cc_werror(config, target) (a
// user relation) turns warnings into errors for target's compiles in
// config: a config_decl name (its slices too) or "*" (every target-role
// instance), and a target id or "*". A target-role instance (t, c) is one
// the user's requests reach: requested in a config_decl configuration, or a
// dependency of such an instance. An exec instance is one only a build-only
// tool needs (tool_dep), e.g. a generator built for the host. Exec
// instances are a separate role, as for sanitizers: "*" leaves them alone
// and the user opts in with cc_werror_exec(target), a target id or "*".
// Naming a configuration through a config_decl also works, since the user
// then chose it. An exec tool's configuration can coincide with a slice of
// a requested one; the instance is then shared and counts as target-role
// only if the requests reach it too.
.decl cc_werror(config:symbol, target:symbol)
.decl cc_werror_exec(target:symbol)
.decl cc_target_role(t:symbol, c:Cfg)
cc_target_role(t, c) :- request(t, n), config_active(n), decl_cfg(n, c), needed(t, c).
cc_target_role(t, c) :- request(t, n), config_active(n), decl_cfg(n, u), config_slice(u, c), needed(t, c).
cc_target_role(d, c) :- cc_target_role(t, c), eff_dep(t, c, d, _).
.decl cc_werror_in(t:symbol, c:Cfg)
cc_werror_in(t, c) :- cc_werror("*", x), cc_target_role(t, c), (x = "*" ; x = t).
cc_werror_in(t, c) :- cc_werror_exec(x), needed(t, c), !cc_target_role(t, c), (x = "*" ; x = t).
error("unknown target", cat(x, " (cc_werror_exec)")) :- cc_werror_exec(x), x != "*", !target_id(x).
cc_werror_in(t, c) :- cc_werror(n, x), decl_cfg(n, c), needed(t, c), (x = "*" ; x = t).
cc_werror_in(t, c) :- cc_werror(n, x), decl_cfg(n, u), config_slice(u, c), needed(t, c), (x = "*" ; x = t).
.decl cc_werror_arg(o:symbol, a:symbol)
cc_werror_arg(o, a) :- cc_compile(t, c, o, l), cc_werror_in(t, c), tc_of(t, l, c, tc), toolchain(tc, f, _),
  family_werror_arg(f, a).
action_arg(o, 9, "", a) :- cc_werror_arg(o, a).
error("unknown config", cat(n, " (cc_werror)")) :- cc_werror(n, _), n != "*", !config_decl(n, _).
error("unknown target", cat(x, " (cc_werror)")) :- cc_werror(_, x), x != "*", !target_id(x).

// Any other -Werror or -Werror=<w> in an argv, however it got there (a
// compile-flag property, a rule's action_arg), is the author's. It is
// policy, and an error, on an action whose program the user chooses (core's
// action_program_user_chosen: a selected toolchain's tool, e.g. every C and
// C++ compile here, or an imported tool the user's package selection binds),
// unless buildlog.toml says [author_decides] cc_werror =
// "reason". Where the author's facts fix the program (core's
// action_program_fixed: a tool the project builds, an imported tool the
// author ties to the library it must match (import_same_package, e.g.
// Halide's runtime compiler), or a toolchain the author pinned) it is
// integrity, and allowed; action_arg_basis records why, for `buildlog why`. Configure
// checks' own arguments (cc_check_args) are not in any action's argv.
action_toolchain(o, l, c) :- cc_compile(_, c, o, l).
.decl cc_author_werror(a:symbol, rank:number, value:symbol, word:symbol)
// An argv word is a prefix and a value (action_arg). Only a prefix that is
// empty, a prefix of "-Werror" (found by index) or contains it can start a
// -Werror word, so cat and match run on those rows, not on all of action_arg.
.decl cc_werror_prefix(p:symbol)
cc_werror_prefix("-"). cc_werror_prefix("-W"). cc_werror_prefix("-We"). cc_werror_prefix("-Wer").
cc_werror_prefix("-Werr"). cc_werror_prefix("-Werro"). cc_werror_prefix("-Werror").
.decl cc_werror_word(a:symbol, rank:number, prefix:symbol, value:symbol, word:symbol)
cc_werror_word(a, r, "", v, v) :- action_arg(a, r, "", v), match("-Werror(=.*)?", v).
cc_werror_word(a, r, p, v, w) :- cc_werror_prefix(p), action_arg(a, r, p, v), w = cat(p, v), match("-Werror(=.*)?", w).
cc_werror_word(a, r, p, v, w) :- action_arg(a, r, p, v), p != "", contains("-Werror", p), w = cat(p, v), match("-Werror(=.*)?", w).
cc_author_werror(a, r, v, w) :- cc_werror_word(a, r, p, v, w),
  (r != 9 ; !cc_werror_arg(a, w)), !tc_platform_arg(_, _, p, v).   // not the toolchain's own
.decl cc_werror_decided(reason:symbol)
cc_werror_decided(reason) :- author_decision("cc_werror", "*", reason).
.decl cc_werror_anyone_decided()
cc_werror_anyone_decided() :- cc_werror_decided(_).
action_error(a, "-Werror is a user decision",
  cat(t, ": ", w, " (", what, " is the user's choice: the user states cc_werror", remedy, "; or add [author_decides] cc_werror = \"reason\" to buildlog.toml)")) :-
  cc_author_werror(a, _, _, w), action_program_user_chosen(a, what, remedy), target_action(t, _, a),
  !cc_werror_anyone_decided().
action_arg_basis(a, r, v, h) :- cc_author_werror(a, r, v, _), action_program_fixed(a, h).
action_arg_basis(a, r, v, cat("[author_decides] cc_werror: ", why)) :- cc_author_werror(a, r, v, _),
  action_program_user_chosen(a, _, _), cc_werror_decided(why).

// ---- Sources by suffix (core's vocabulary: [target.X] sources = [...]) ----
// A C or C++ source by its suffix, as CMake's LANGUAGE default; a header is
// claimed and compiles nothing (CMake lists headers among sources for IDEs).
.decl source_suffix(suffix:symbol, lang:symbol)   // lang: c | cxx | header
source_suffix(".c", "c").
// Preprocessed assembly, compiled by the C compiler (CMake's ASM language
// defaults to it too; clang, GCC and TCC all take x.S with -c).
source_suffix(".S", "c").
source_suffix(".cc", "cxx"). source_suffix(".cpp", "cxx"). source_suffix(".cxx", "cxx"). source_suffix(".c++", "cxx").
source_suffix(".h", "header"). source_suffix(".hh", "header"). source_suffix(".hpp", "header").
source_suffix(".hxx", "header"). source_suffix(".inl", "header"). source_suffix(".inc", "header").
.decl source_lang(t:symbol, f:symbol, lang:symbol)
source_lang(t, f, l) :- target_sources(t, f), source_suffix(s, l),
  strlen(f) > strlen(s), substr(f, strlen(f) - strlen(s), strlen(s)) = s.
source_claimed(t, f) :- source_lang(t, f, _).
c_source(t, f) :- source_lang(t, f, "c").
cxx_source(t, f) :- source_lang(t, f, "cxx").

// ---- Generated files (core V_generators.dl) ----
// A generator's outputs are generated headers of its owner, public: the
// owner's users compile after them too (a private one would leave a user's
// compile unordered). gen_include puts the owner's generated directory (or
// a subdirectory) on its include path.
prop_in(o, c, "cc.generated_header", p, "public") :- gen_output(o, c, p).
prop_in(t, c, "cc.include_dir", d, v) :- target_gen_include(t, v, ""), gen_dir(t, c, d).
prop_in(t, c, "cc.include_dir", cat(d, "/", s), v) :- target_gen_include(t, v, s), s != "", gen_dir(t, c, d).
// An imported target's data files are below its include directory (SPIRV-Headers
// ships its grammars under include/spirv/unified1): the one it states, where
// it is an import (import_origin), so `why` leads to the package selection.
package_data_root(t, c, d) :- package_file_want(t, _), eff_prop(t, c, "cc.include_dir", d, _),
  import_origin(t, p, _, _, _), config_platform(c, p).
.decl package_root_dirs(t:symbol, c:Cfg, n:number)
package_root_dirs(t, c, n) :- package_file_want(t, _), needed(t, c),
  n = count : { eff_prop(t, c, "cc.include_dir", _, _) }.
error_at("package data: the package states several include dirs", t, t, c) :-
  package_root_dirs(t, c, n), n > 1.
prop_in(t, c, "cc.include_dir", d, "private") :- gen_user(t, o), needed(t, c), gen_dir(o, c, d).
prop_in(t, c, "cc.generated_header", p, "private") :- gen_user(t, o), needed(t, c), gen_output(o, c, p).

// ---- a library built both ways (core linkage_twin) ----
// Its shared instance compiles the same sources with the same groups,
// ISA sets and flags; only the linkage-dependent arguments (-fPIC, the
// shared linkage_prop) differ.
cxx_source(i, s) :- linkage_twin(i, t), cxx_source(t, s).
c_source(i, s) :- linkage_twin(i, t), c_source(t, s).
source_group(i, g) :- linkage_twin(i, t), source_group(t, g).
group_source(i, g, s) :- linkage_twin(i, t), group_source(t, g, s).
group_when(i, g, n) :- linkage_twin(i, t), group_when(t, g, n).
group_prop(i, g, k, v) :- linkage_twin(i, t), group_prop(t, g, k, v).
group_prop_when(i, g, k, v, n) :- linkage_twin(i, t), group_prop_when(t, g, k, v, n).
isa_group(i, g, s) :- linkage_twin(i, t), isa_group(t, g, s).
isa_target(i, s) :- linkage_twin(i, t), isa_target(t, s).
cc_pic(i) :- linkage_twin(i, t), cc_pic(t).
cc_werror(n, i) :- linkage_twin(i, t), cc_werror(n, t).
cc_werror_exec(i) :- linkage_twin(i, t), cc_werror_exec(t).
cc_target_role(i, c) :- linkage_twin(i, t), cc_target_role(t, c), needed(i, c).
